def view_all_logs():
    print("\n=== All Logs ===")
    for log in logs:
        print(f"{log['user']} | {log['ip']} | {log['status']} | {log['time']}")

def view_failed_logs():
    print("\n=== Brute Force Detection ===")
    users_checked = []
    for log in logs:
        if log["user"] not in users_checked:
            users_checked.append(log["user"])
    for user in users_checked:
        count = 0
        for log in logs:
            if log["user"] == user and log["status"] == "failed":
                count += 1
        if count >= 3:
            print(f"⚠️  BRUTE FORCE: {user} - {count} failed attempts")

def threat_detect():
    print("\n=== Threat Detection Report ===")
    users_checked = []
    for log in logs:
        if log["user"] not in users_checked:
            users_checked.append(log["user"])
    for user in users_checked:
        count = 0
        for log in logs:
            if log["user"] == user and log["status"] == "failed":
                count += 1
        if count >= 3:
            print(f"⚠️  BRUTE FORCE: {user} - {count} failed attempts")
    for log in logs:
        if log["time"] >= "00:00" and log["time"] <= "06:00":
            print(f"⚠️  SUSPICIOUS TIME: {log['user']} logged in at {log['time']}")

def search_by_user():
    name = input("Enter username: ")
    for log in logs:
        if log["user"] == name:
            print(f"{log['user']} | {log['ip']} | {log['status']} | {log['time']}")

