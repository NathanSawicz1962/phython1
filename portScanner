import socket

common_ports = [20, 21, 22, 80, 443, 3389, 8080]

def scan_port(host, port):
    scanner = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    scanner.settimeout(1)
    result = scanner.connect_ex((host, port))
    scanner.close()
    if result == 0:
        return "OPEN 🟢"
    else:
        return "CLOSED 🔴"

def scan_common():
    host = "127.0.0.1"
    print("\n=== Common Port Scan ===")
    for port in common_ports:
        result = scan_port(host, port)
        print(f"Port {port} is {result}")

def scan_specific():
    host = "127.0.0.1"
    port = int(input("Enter port number: "))
    result = scan_port(host, port)
    print(f"Port {port} is {result}")

def scan_range():
    host = "127.0.0.1"
    start = int(input("Enter start port: "))
    end = int(input("Enter end port: "))
    for port in range(start, end):
        result = scan_port(host, port)
        print(f"Port {port} is {result}")

while True:
    print("\n=== Port Scanner ===")
    print("1. Scan common ports")
    print("2. Scan specific port")
    print("3. Scan range of ports")
    print("4. Quit")
    choice = input("\nChoose an option: ")
    if choice == "1":
        scan_common()
    elif choice == "2":
        scan_specific()
    elif choice == "3":
        scan_range()
    elif choice == "4":
        break
